-- 5. RUNTIME
task.spawn(function()
    local ef = ReplicatedStorage:FindFirstChild("Emotes", true); local cf = ReplicatedStorage:FindFirstChild("CutscenesFolder", true)
    if ef then populateDeep(ef, eScroll, eLayout) end; if cf then populateDeep(cf, aScroll, aLayout) end

    while task.wait(1) do
        if MasterToggle then
            if ActiveToggles.Killers then clearCategory("Killers"); for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer and p.Character and isKiller(p) then applyESP(p.Character, p.Name:upper(), Color3.new(1,0,0), "Killers", true) end end end
            if ActiveToggles.Survivors then clearCategory("Survivors"); for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer and p.Character and not isKiller(p) then applyESP(p.Character, p.Name:upper(), Color3.new(0,1,0), "Survivors", true) end end end
            if ActiveToggles.Traps then clearCategory("Traps"); for _, o in ipairs(Workspace:GetDescendants()) do if o.Name:find("BearTrap") or o.Name:find("Trap") then applyESP(o, "TRAP", Color3.new(1,1,0), "Traps", true) end end end
        end
        
        clearCategory("Clients")
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                local emoteTag = p:GetAttribute("CurrentBBNEmote")
                if (emoteTag ~= nil) and ActiveToggles.Clients then
                    applyESP(p.Character, "CLIENT USER: "..p.Name:upper(), Color3.new(0.4, 0.4, 1), "Clients", true)
                end
                if emoteTag and emoteTag ~= "" then
                    local head = p.Character:FindFirstChild("Head")
                    if head and not head:FindFirstChild("SyncSound") then
                        local mod = ReplicatedStorage:FindFirstChild(emoteTag, true)
                        local soundObj = mod and (mod:FindFirstChild("Sound") or mod:FindFirstChild("StartSound"))
                        if soundObj then
                            local s = soundObj:Clone(); s.Name = "SyncSound"; s.Parent = head; s:Play()
                            Debris:AddItem(s, s.TimeLength > 0 and s.TimeLength or 5)
                        end
                    end
                end
            end
        end
    end
end)

-- Draggable logic
local d, s, st
topBar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then d = true s = i.Position st = mainFrame.Position end end)
UserInputService.InputChanged:Connect(function(i) if d and i.UserInputType == Enum.UserInputType.MouseMovement then local delta = i.Position - s mainFrame.Position = UDim2.new(st.X.Scale, st.X.Offset + delta.X, st.Y.Scale, st.Y.Offset + delta.Y) end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then d = false end end)
