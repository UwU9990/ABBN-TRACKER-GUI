local function applyESP(obj, text, color, category, perm)
    if not obj then return end
    local h = Instance.new("Highlight"); h.FillColor = color; h.Parent = obj
    local b = Instance.new("BillboardGui"); b.Size = UDim2.new(0, 80, 0, 20); b.AlwaysOnTop = true
    local l = Instance.new("TextLabel"); l.Size = UDim2.new(1,0,1,0); l.Text = text; l.TextColor3 = color; l.BackgroundTransparency = 1; l.Parent = b
    b.Adornee = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj; b.Parent = obj
    if perm then table.insert(PersistentVisuals[category], h); table.insert(PersistentVisuals[category], b)
    else task.delay(1, function() if h then h:Destroy() end if b then b:Destroy() end end) end
end

local function clearCategory(cat)
    for _, v in ipairs(PersistentVisuals[cat]) do if v then v:Destroy() end end
    PersistentVisuals[cat] = {}
end

local function createMain(txt, clr)
    local b = Instance.new("TextButton"); b.Size = UDim2.new(0.9, 0, 0, 26); b.Text = txt
