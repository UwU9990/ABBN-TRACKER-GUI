local function populateDeep(folder, scroll, layout)
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("ModuleScript") then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0.9, 0, 0, 25); b.Text = item.Name:upper()
            b.BackgroundColor3 = Color3.fromRGB(40, 40, 40); b.TextColor3 = Color3.new(1, 1, 1)
            b.Parent = scroll
            b.MouseButton1Click:Connect(function()
                if folder.Name == "Emotes" then playToggledEmote(item) else
                    local anim = item:FindFirstChildWhichIsA("Animation")
                    if anim then humanoid:LoadAnimation(anim):Play() end
                end
            end)
        elseif item:IsA("Folder") then populateDeep(item, scroll, layout) end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
end

-- 3. ESP ENGINE
local function applyESP(obj, text, color, category, perm)
    if not obj then return end
    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
    if not part then return end

    local h = Instance.new("Highlight"); h.FillColor = color; h.Parent = obj
    local b = Instance.new("BillboardGui"); b.Size = UDim2.new(0, 80, 0, 20); b.AlwaysOnTop = true
    local l = Instance.new("TextLabel"); l.Size = UDim2.new(1,0,1,0); l.Text = text
    l.TextColor3 = color; l.BackgroundTransparency = 1; l.Parent = b
    b.Adornee = part; b.Parent = obj

    if perm then 
        table.insert(PersistentVisuals[category], h) 
        table.insert(PersistentVisuals[category], b)
    else 
        task.delay(1, function() if h then h:Destroy() end if b then b:Destroy() end end) 
    end
end

local function isKiller(p) return p:GetAttribute("TEAM") == "Killer" end

