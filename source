-- LocalScript: BBN Tracker V25 (Lightweight Edition)
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local localPlayer = Players.LocalPlayer
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- State Management
local MasterToggle = false 
local ActiveToggles = {Killers = false, Survivors = false, Traps = false, Minions = false}
local PersistentVisuals = {Killers = {}, Survivors = {}, Traps = {}, Minions = {}}

-- 1. UTILITY FUNCTIONS
local function clearCategory(cat)
    if PersistentVisuals[cat] then
        for _, v in ipairs(PersistentVisuals[cat]) do if v then v:Destroy() end end
        PersistentVisuals[cat] = {}
    end
end

local function applyESP(obj, text, color, category, perm)
    if not obj then return end
    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
    if not part then return end

    local h = Instance.new("Highlight"); h.FillColor = color; h.Parent = obj
    local b = Instance.new("BillboardGui"); b.Size = UDim2.new(0, 80, 0, 20); b.AlwaysOnTop = true
    local l = Instance.new("TextLabel"); l.Size = UDim2.new(1,0,1,0); l.Text = text; l.TextColor3 = color; l.BackgroundTransparency = 1; l.Parent = b
    b.Adornee = part; b.Parent = obj

    if perm then 
        table.insert(PersistentVisuals[category], h) 
        table.insert(PersistentVisuals[category], b)
    else 
        task.delay(1, function() if h then h:Destroy() end if b then b:Destroy() end end) 
    end
end

-- 2. UI CONSTRUCTION
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BBN_Tracker_Lite"; screenGui.ResetOnSpawn = false; screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 250); mainFrame.Position = UDim2.new(0.5, -100, 0.4, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30); mainFrame.BorderSizePixel = 0; mainFrame.Parent = screenGui

local topBar = Instance.new("Frame")
topBar.Size = UDim2.new(1, 0, 0, 30); topBar.BackgroundColor3 = Color3.fromRGB(15, 15, 15); topBar.Parent = mainFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -35, 1, 0); title.Position = UDim2.new(0, 10, 0, 0); title.Text = "BBN TRACKER LITE"
title.TextColor3 = Color3.new(1, 1, 1); title.BackgroundTransparency = 1; title.Font = Enum.Font.GothamBold; title.Parent = topBar

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30); closeBtn.Position = UDim2.new(1, -30, 0, 0); closeBtn.Text = "X"
closeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50); closeBtn.TextColor3 = Color3.new(1, 1, 1); closeBtn.Parent = topBar

local content = Instance.new("Frame")
content.Size = UDim2.new(1, 0, 1, -40); content.Position = UDim2.new(0, 0, 0, 40)
content.BackgroundTransparency = 1; content.Parent = mainFrame

local mainLayout = Instance.new("UIListLayout")
mainLayout.Padding = UDim.new(0, 4); mainLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center; mainLayout.Parent = content

local modeBtn = Instance.new("TextButton")
modeBtn.Size = UDim2.new(0.9, 0, 0, 28); modeBtn.Text = "MODE: PING (1S)"
modeBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70); modeBtn.TextColor3 = Color3.new(1, 1, 1); modeBtn.Parent = content

local function createMain(txt, clr)
    local b = Instance.new("TextButton"); b.Size = UDim2.new(0.9, 0, 0, 26); b.Text = txt
    b.BackgroundColor3 = clr or Color3.fromRGB(45, 45, 45); b.TextColor3 = Color3.new(1, 1, 1); b.Parent = content
    return b
end

local kBtn = createMain("KILLERS", Color3.fromRGB(80, 20, 20))
local sBtn = createMain("SURVIVORS", Color3.fromRGB(20, 80, 20))
local tBtn = createMain("TRAPS", Color3.fromRGB(80, 80, 20))
local mBtn = createMain("MINIONS", Color3.fromRGB(0, 80, 80))

-- 3. BUTTON LOGIC
kBtn.MouseButton1Click:Connect(function()
    if MasterToggle then ActiveToggles.Killers = not ActiveToggles.Killers if not ActiveToggles.Killers then clearCategory("Killers") end 
    else for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer and p.Character and p:GetAttribute("TEAM") == "Killer" then applyESP(p.Character, p.Name:upper(), Color3.new(1,0,0), "Killers", false) end end end
end)

sBtn.MouseButton1Click:Connect(function()
    if MasterToggle then ActiveToggles.Survivors = not ActiveToggles.Survivors if not ActiveToggles.Survivors then clearCategory("Survivors") end
    else for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer and p.Character and p:GetAttribute("TEAM") ~= "Killer" then applyESP(p.Character, p.Name:upper(), Color3.new(0,1,0), "Survivors", false) end end end
end)

tBtn.MouseButton1Click:Connect(function()
    if MasterToggle then ActiveToggles.Traps = not ActiveToggles.Traps if not ActiveToggles.Traps then clearCategory("Traps") end
    else for _, o in ipairs(Workspace:GetDescendants()) do if o.Name:find("BearTrap") or o.Name:find("Trap") then applyESP(o, "TRAP", Color3.new(1,1,0), "Traps", false) end end end
end)

mBtn.MouseButton1Click:Connect(function()
    if MasterToggle then ActiveToggles.Minions = not ActiveToggles.Minions if not ActiveToggles.Minions then clearCategory("Minions") end
    else for _, o in ipairs(Workspace:GetDescendants()) do if o.Name:find("Minion") then applyESP(o, "MINION", Color3.new(0,1,1), "Minions", false) end end end
end)

modeBtn.MouseButton1Click:Connect(function()
    MasterToggle = not MasterToggle
    modeBtn.Text = MasterToggle and "MODE: TOGGLE (PERM)" or "MODE: PING (1S)"
    modeBtn.BackgroundColor3 = MasterToggle and Color3.fromRGB(0, 80, 150) or Color3.fromRGB(70, 70, 70)
    if not MasterToggle then 
        for k, _ in pairs(ActiveToggles) do ActiveToggles[k] = false; clearCategory(k) end 
    end
end)

closeBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)

-- 4. RUNTIME LOOP (Keeps ESP updated in Toggle Mode)
task.spawn(function()
    while task.wait(1.5) do
        if MasterToggle then
            if ActiveToggles.Killers then
                clearCategory("Killers")
                for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer and p.Character and p:GetAttribute("TEAM") == "Killer" then applyESP(p.Character, p.Name:upper(), Color3.new(1,0,0), "Killers", true) end end
            end
            if ActiveToggles.Survivors then
                clearCategory("Survivors")
                for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer and p.Character and p:GetAttribute("TEAM") ~= "Killer" then applyESP(p.Character, p.Name:upper(), Color3.new(0,1,0), "Survivors", true) end end
            end
            if ActiveToggles.Traps then
                clearCategory("Traps")
                for _, o in ipairs(Workspace:GetDescendants()) do if o.Name:find("BearTrap") or o.Name:find("Trap") then applyESP(o, "TRAP", Color3.new(1,1,0), "Traps", true) end end
            end
            if ActiveToggles.Minions then
                clearCategory("Minions")
                for _, o in ipairs(Workspace:GetDescendants()) do if o.Name:find("Minion") then applyESP(o, "MINION", Color3.new(0,1,1), "Minions", true) end end
            end
        end
    end
end)

-- Draggable logic
local d, s, st
topBar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then d = true s = i.Position st = mainFrame.Position end end)
UserInputService.InputChanged:Connect(function(i) if d and i.UserInputType == Enum.UserInputType.MouseMovement then local delta = i.Position - s mainFrame.Position = UDim2.new(st.X.Scale, st.X.Offset + delta.X, st.Y.Scale, st.Y.Offset + delta.Y) end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then d = false end end)
