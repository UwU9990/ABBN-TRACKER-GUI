-- 1. EMOTE SYSTEM (Local Only)
local function stopAllEmotes()
    ActiveEmoteName = nil
    for track, _ in pairs(CurrentTracks) do track:Stop() end
    for sound, _ in pairs(CurrentSounds) do sound:Stop(); sound:Destroy() end
    CurrentTracks = {}
    CurrentSounds = {}
end

local function playToggledEmote(module)
    if ActiveEmoteName == module.Name then stopAllEmotes() return end
    stopAllEmotes()
    ActiveEmoteName = module.Name

    local startAnim = module:FindFirstChild("Start") or module:FindFirstChild("Anim")
    local loopAnim = module:FindFirstChild("Loop")
    local startSound = module:FindFirstChild("StartSound")
    local loopSound = module:FindFirstChild("Sound")

    local function playLoop()
        if ActiveEmoteName ~= module.Name then return end
        if loopAnim then
            local track = humanoid:LoadAnimation(loopAnim)
            track.Looped = true; track:Play()
            CurrentTracks[track] = true
        end
        if loopSound then
            local s = loopSound:Clone(); s.Parent = character:FindFirstChild("Head")
            s.Looped = true; s:Play()
            CurrentSounds[s] = true
        end
    end

    if startAnim then
        local stTrack = humanoid:LoadAnimation(startAnim)
        stTrack:Play(); CurrentTracks[stTrack] = true
        if startSound then
            local stS = startSound:Clone(); stS.Parent = character:FindFirstChild("Head")
            stS:Play(); CurrentSounds[stS] = true
            Debris:AddItem(stS, stS.TimeLength + 1)
        end
        if loopAnim then
            stTrack.Stopped:Connect(function()
                if ActiveEmoteName == module.Name then playLoop() end
            end)
        else
            stTrack.Looped = true
        end
    elseif loopAnim then playLoop() end
end

